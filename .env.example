# --- Backend principal: qwen-reverse ---
QWEN_REVERSE=1
QWEN_REVERSE_BASE_URL=http://127.0.0.1:8090
QWEN_MODEL=qwen3.8-max-thinking
# Opcional para una cuenta de chat.qwen.ai:
QWEN_TOKEN=
# Reintentos ante respuestas vacías del backend web (default 5) y backoff
# en segundos entre intentos. Los intentos impares usan reasoning_effort=none
# para escapar del modo que a veces traba al backend con contexto largo.
QWEN_EMPTY_RETRIES=5
QWEN_EMPTY_RETRY_DELAYS=2,4,8,15,30

# --- OpenCode Zen (gateway opencode.ai/zen) ---
# Key del gateway. Si no la seteás, el bridge intenta leer la key de opencode
# local (~/.local/share/opencode/auth.json, entrada "opencode").
# ZEN_API_KEY=sk-...
# Cualquier modelo del gateway se puede pedir con prefijo "opencode/":
#   QWEN_MODEL=opencode/deepseek-v4-flash-free   (gratis)
#   QWEN_MODEL=opencode/claude-fable-5           (pago)
#   QWEN_MODEL=opencode/gpt-5.5-pro
# ZEN_BASE_URL=https://opencode.ai/zen/v1

# --- OpenRouter (https://openrouter.ai) ---
# Cientos de modelos con una sola key. Prefijo "openrouter/":
#   QWEN_MODEL=openrouter/openrouter/auto
#   QWEN_MODEL=openrouter/anthropic/claude-sonnet-4.5
#   QWEN_MODEL=openrouter/google/gemini-3-pro
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Groq (inferencia ultrarrápida, https://console.groq.com) ---
# Prefijo "groq/":
#   QWEN_MODEL=groq/llama-3.3-70b-versatile
#   QWEN_MODEL=groq/openai/gpt-oss-120b
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://groq.com/openai/v1

# --- DeepSeek directo (https://platform.deepseek.com) ---
# Prefijo "deepseek/":
#   QWEN_MODEL=deepseek/deepseek-chat
#   QWEN_MODEL=deepseek/deepseek-reasoner
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Local OpenAI-compatible (Ollama, LM Studio, vLLM, llama.cpp) ---
# Prefijo "local/". No requiere API key:
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1   (Ollama)
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1   (LM Studio)
#   QWEN_MODEL=local/llama3.1
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=

# Cualquier modelo pedido sin prefijo que no sea Qwen se envía al primer
# proveedor configurado de la lista anterior; si no hay ninguno, se usa
# qwen-reverse.
